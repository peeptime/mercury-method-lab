{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.v8-mercury/memory-preaudit-bundle.schema.json",
  "title": "Mercury Lab Memory Pre-Audit Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "target_backend",
    "contract_ref",
    "source_index_ref",
    "summary",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "generated_at": {
      "type": "string"
    },
    "target_backend": {
      "type": "string"
    },
    "contract_ref": {
      "type": "string"
    },
    "source_index_ref": {
      "type": "string"
    },
    "direct_runtime_write_allowed": {
      "type": "boolean",
      "const": false
    },
    "summary": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "sample_type",
          "routing_decision",
          "target_backend",
          "source_refs",
          "blockers"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sample_type": {
            "type": "string"
          },
          "routing_decision": {
            "type": "string",
            "enum": [
              "discard",
              "archive",
              "review",
              "promote"
            ]
          },
          "target_backend": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audit_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memory_level": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "review_at": {
            "type": "string"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
