{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.v8-mercury/artifact.schema.json",
  "title": "V8 Mercury Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "status",
    "owner_role",
    "source_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "raw",
        "segmented",
        "cleaned",
        "uncertain",
        "memory_candidate",
        "decision_log",
        "action_plan",
        "audit_report",
        "export"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_ready",
        "audited",
        "approved",
        "superseded",
        "rejected"
      ]
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "collector",
        "cleaner",
        "memory-curator",
        "decision-owner",
        "auditor",
        "operator"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "review_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
  },
  "additionalProperties": true
}
