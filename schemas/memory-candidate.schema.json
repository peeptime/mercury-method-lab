{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.v8-mercury/memory-candidate.schema.json",
  "title": "V8 Mercury Memory Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "status",
    "content",
    "source_refs",
    "confidence",
    "risk",
    "owner_role",
    "created_at",
    "review_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "const": "memory_candidate"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_ready",
        "audited",
        "approved",
        "superseded",
        "rejected"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "time_scope": {
      "type": "string"
    },
    "use_case": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "discarded": {
      "type": "boolean"
    },
    "owner_role": {
      "type": "string",
      "const": "memory-curator"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "review_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
  },
  "additionalProperties": false
}
