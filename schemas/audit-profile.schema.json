{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mercury/audit-profile.schema.json",
  "title": "Mercury Audit Profile",
  "type": "object",
  "required": ["id", "label", "posture"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "posture": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "minimum_route": { "enum": ["accept", "revise", "quarantine", "discard"] },
    "require_human_for_high_risk": { "type": "boolean" },
    "source_floor": { "enum": ["primary_or_direct", "traceable", "secondary", "ai_generated", "unknown"] }
  },
  "additionalProperties": true
}
