# Required for Ark Coding Plan access.
ARK_API_KEY=

# Optional. Defaults to doubao-seed-2.0-code.
ARK_MODEL=doubao-seed-2.0-code

# Optional. Defaults to config/model-providers.json active_provider.
MERCURY_MODEL_PROVIDER=ark-coding-plan

# Optional reserved hosted OpenAI-compatible provider.
MERCURY_OPENAI_BASE_URL=
MERCURY_OPENAI_API_KEY=
MERCURY_OPENAI_MODEL=

# Optional aliases accepted by hosted OpenAI-compatible providers.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
MERCURY_API_KEY=
MERCURY_BASE_URL=
MERCURY_MODEL=

# Optional reserved local OpenClaw-compatible provider.
OPENCLAW_BASE_URL=http://127.0.0.1:11434/v1
OPENCLAW_API_KEY=
OPENCLAW_MODEL=

# Optional local OpenAI-compatible runtimes. These do not require API keys by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=local-model
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
MERCURY_LOCAL_MODEL=

# Optional. Defaults to the current user's ~/.mercury/skills directory.
MERCURY_SKILLS_DIR=

# Optional. Keep disabled unless non-markdown files or URLs need conversion into 00_raw.
MERCURY_MARKITDOWN_ENABLED=false
