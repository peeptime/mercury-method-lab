{
  "name": "mercury-method-lab",
  "version": "0.4",
  "private": true,
  "type": "module",
  "description": "AI 判断输出的审计基础设施。给 AI 的判断过程留下不可跳过的架构约束，解决概率模型带来的意图命中偏差和认知曲线盲区。",
  "scripts": {
    "check:upstream": "node scripts/check_upstream_mercury_agent.mjs",
    "dashboard": "node scripts/dashboard_server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "index": "node scripts/rebuild_index.mjs",
    "import:viewpoint": "node scripts/import_viewpoint.mjs",
    "ingest:doc": "node scripts/ingest_document.mjs",
    "v8:analyze": "node scripts/run_v8_analysis.mjs",
    "sync:skills": "node scripts/sync_skills.mjs",
    "validate": "node scripts/validate_artifacts.mjs",
    "test:llm": "node scripts/test_ark_coding_plan.mjs",
    "test:ark": "node scripts/test_ark_coding_plan.mjs",
    "test:skill": "node scripts/run_mercury_skill_test.mjs",
    "start:llm": "node scripts/start_mercury_provider.mjs",
    "start:ark": "node scripts/start_mercury_provider.mjs",
    "start:ark:legacy": "powershell -ExecutionPolicy Bypass -File scripts/start_mercury_ark.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
